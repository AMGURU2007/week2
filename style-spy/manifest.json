{
  "manifest_version": 3,
  "name": "Style Spy",
  "version": "1.0.0",
  "description": "Inspect active webpage color palettes and typography in one click, save design kits, and export CSS variables.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Style Spy - Inspect Design Tokens"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
